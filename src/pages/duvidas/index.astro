---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPostsByCategory } from '../../lib/data.js';

const posts = getPostsByCategory('duvidas');
---

<Layout
  title="Dúvidas sobre Lava-Louças – Guias Práticos e Dicas"
  description="Aqui você encontrará respostas para as principais questões relacionadas ao uso, instalação e funcionamento das máquinas de lavar louça."
  canonicalPath="/duvidas/"
>
  <div class="container" style="padding-top: 2.5rem; padding-bottom: 5rem;">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Navegação estrutural">
      <a href="/" class="breadcrumb-item">Início</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">Dúvidas frequentes</span>
    </nav>

    <!-- Header Moderno da Categoria -->
    <header class="section-header-modern" style="margin-bottom: 3.5rem;">
      <span class="section-tag" style="background-color: #fef3c7; color: #b45309;">Dicas e tutoriais práticos</span>
      <h1 class="section-title-modern">
        Dúvidas frequentes e cuidados
      </h1>
      <p class="section-desc-modern">
        Guias práticos, tutoriais de manutenção, dicas de instalação e respostas diretas para descomplicar a sua rotina com a lava-louças.
      </p>
      <div style="margin-top: 1rem; font-size: 0.88rem; color: #64748b; font-weight: 600;">
        Exibindo {posts.length} artigos explicativos
      </div>
    </header>

    <div class="posts-grid">
      {posts.map((post, idx) => (
        <PostCard post={post} isFirst={idx === 0} />
      ))}
    </div>
  </div>
</Layout>
